# Allow KProfiles to be adjusted by a system app
allow system_app sysfs_kprofiles:file rw_file_perms;

binder_call(system_app, hal_camera_default)
binder_call(system_app, hal_fingerprint_default)
binder_call(system_app, hal_bootctl_default)
binder_call(system_app, hal_audio_default)

# Zram
allow system_app sysfs_zram:dir r_dir_perms;
allow system_app sysfs_zram:file r_file_perms;

# Allow passthrough charge interface to be adjusted by a system app
allow system_app vendor_sysfs_usb_supply:dir r_dir_perms;
allow system_app vendor_sysfs_usb_supply:file rw_file_perms;
